<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SkyBook" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Splash screen (androidx.core:core-splashscreen) shown while the app starts. -->
    <style name="Theme.SkyBook.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_blue</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_plane</item>
        <item name="postSplashScreenTheme">@style/Theme.SkyBook</item>
    </style>
</resources>
